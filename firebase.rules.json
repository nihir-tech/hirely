{
  "rules": {
    "devices": {
      ".read": true,
      "$id": {
        ".write": "newData.isBoolean()"
      }
    },
    "presence": {
      ".read": true,
      "$id": {
        ".write": "!newData.exists() || newData.isBoolean() || (newData.isMap() && newData.hasChildren(['at']) && newData.child('at').isNumber())"
      }
    },
    "submissions": {
      ".read": "auth != null && (auth.token.email == 'nihir12121@gmail.com' || auth.token.email == 'sartanparanihir@gmail.com' || auth.token.email == 'ferved69@gmail.com' || auth.token.email == 'gpstracking24x7@gmail.com')",
      ".write": "auth != null"
    },
    "sessions": {
      ".read": "auth != null && (auth.token.email == 'nihir12121@gmail.com' || auth.token.email == 'sartanparanihir@gmail.com' || auth.token.email == 'ferved69@gmail.com' || auth.token.email == 'gpstracking24x7@gmail.com')",
      "$id": {
        ".write": "!newData.exists() || (auth != null && newData.child('email').val() == auth.token.email && newData.hasChild('at') && newData.child('at').isNumber())"
      }
    },
    "visits": {
      ".read": "auth != null && (auth.token.email == 'nihir12121@gmail.com' || auth.token.email == 'sartanparanihir@gmail.com' || auth.token.email == 'ferved69@gmail.com' || auth.token.email == 'gpstracking24x7@gmail.com')",
      "$id": {
        ".write": "!data.exists() && newData.hasChildren(['deviceId','email','displayName','kind','at']) && newData.child('at').isNumber()"
      }
    }
  }
}