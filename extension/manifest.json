{
  "manifest_version": 3,
  "name": "Hirely — LinkedIn Job Copilot & Resume Matcher",
  "version": "1.0.0",
  "description": "Live resume-to-job match scores on LinkedIn, missing-skill alerts, smart startup/early-bird job finder, AI recruiter pitches, 1-click profile import, and pipeline sync with Hirely.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hirely LinkedIn Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://hirelly.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "lib/matcher.js",
        "content/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hirelly.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "content/hirely-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

