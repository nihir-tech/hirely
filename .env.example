# Hirely — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or expose these values in client-side code.

# Required: Your OpenAI API key (server-side only, via Netlify Functions)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override the default model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
